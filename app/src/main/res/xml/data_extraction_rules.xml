<?xml version="1.0" encoding="utf-8"?>
<!-- Backup and device transfer for Android 12+ (API 31+). Keep in sync with backup_rules.xml:
     everything is kept except this phone's sensor bookkeeping and movement log. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/wigglebun_device.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/wigglebun_device.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
