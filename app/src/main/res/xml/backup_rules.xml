<?xml version="1.0" encoding="utf-8"?>
<!-- Auto Backup for Android 11 and older (API 30-). Keep in sync with data_extraction_rules.xml.
     Backed up: settings, pet name, sit timer (datastore/wigglebun_prefs) and the break log and
     sparks (Room), so a new phone keeps the user's progress.
     Not backed up: datastore/wigglebun_device, this phone's sensor bookkeeping and movement log
     (wrong on another phone, and activity data stays on the device). -->
<full-backup-content>
    <exclude domain="file" path="datastore/wigglebun_device.preferences_pb" />
</full-backup-content>
