    <string name="break_stand_up">Stand up</string>
    <string name="break_walk">2-min walk</string>
    <string name="break_neck">Neck stretch</string>
    <string name="break_shoulders">Shoulder rolls</string>
    <string name="break_wrist">Wrist stretch</string>
    <string name="break_eyes">Eyes rest</string>
    <string name="break_water">Drink water</string>

    <!-- Break reminder notification -->
    <string name="channel_break_reminders_name">Break reminders</string>
    <string name="channel_break_reminders_description">Gentle nudges from your pet to stand up and stretch</string>
    <string name="reminder_title">Time for a Bun Break</string>
    <!-- %1$s is the pet's name -->
    <string-array name="reminder_texts">
        <item>%1$s is getting stiff… 2-minute stretch?</item>
        <item>%1$s has been sitting with you for a while. Bun Break?</item>
        <item>%1$s\'s ears are drooping. Stand up together?</item>
        <item>%1$s would love a quick wiggle. Coming?</item>
    </string-array>
    <!-- Suggested break, e.g. "Neck stretch · 2 min" -->
    <string name="reminder_suggestion">%1$s · %2$d min</string>
    <string name="action_done">Done</string>
    <string name="action_snooze">Snooze 10 min</string>
    <string name="action_skip">Skip</string>

    <!-- Home -->
    <string name="home_time_since_break">Time since last break</string>
    <plurals name="home_minutes">
        <item quantity="one">%d min</item>
        <item quantity="other">%d min</item>
    </plurals>
    <!-- Mood chip on the timer pill; %1$s is the pet's name -->
    <string name="home_chip_great">%1$s feels great</string>
    <string name="home_chip_tired">%1$s is getting tired</string>
    <string name="home_chip_stiff">%1$s is stiff</string>
    <string name="home_chip_walk">%1$s is out on a walk</string>
    <!-- Outside work hours (no timer, no guilt) -->
    <string name="home_asleep_title">%1$s is asleep</string>
    <!-- %1$s is a time like 9:00 -->
    <string name="home_work_starts_today">Work hours start today at %1$s</string>
    <string name="home_work_starts_tomorrow">Work hours start tomorrow at %1$s</string>
    <!-- %1$s is a weekday like Monday, %2$s a time -->
    <string name="home_work_starts_on">Work hours start %1$s at %2$s</string>
    <string name="home_no_work_hours">No work hours set</string>
    <string name="home_take_break">Take a 2-min break</string>
    <string name="home_breaks_title">Breaks for today</string>
    <string name="home_breaks_done">%1$d of %2$d done</string>
    <string name="home_break_skipped">Skipped today</string>
    <string name="home_reward">+%1$d</string>

