<resources>
    <string name="app_name">Wigglebun</string>

    <!-- Bottom tabs -->
    <string name="tab_home">Home</string>
    <string name="tab_collection">Collection</string>
    <string name="tab_settings">Settings</string>
    <!-- Starter pet name; also the pet tab label until the user names their pet -->
    <string name="pet_default_name">Bun</string>

    <!-- Pet accessibility labels; %1$s is the pet's name -->
    <string name="pet_desc_happy">%1$s, happy and full of energy</string>
    <string name="pet_desc_tired">%1$s, energy draining from sitting</string>
    <string name="pet_desc_stiff">%1$s, stiff from sitting too long</string>
    <string name="pet_desc_stretch">%1$s, stretching</string>
    <string name="pet_desc_celebrate">%1$s, celebrating</string>
    <string name="pet_desc_sleeping">%1$s, sleeping</string>

    <string name="coming_soon">Coming soon</string>

    <!-- Break types (CLAUDE.md §5.3) -->
    <string name="break_stand_up">Stand up</string>
    <string name="break_walk">2-min walk</string>
    <string name="break_neck">Neck stretch</string>
    <string name="break_shoulders">Shoulder rolls</string>
    <string name="break_wrist">Wrist stretch</string>
    <string name="break_eyes">Eyes rest</string>
    <string name="break_water">Drink water</string>

    <!-- Break reminder notification -->
    <string name="channel_break_reminders_name">Break reminders</string>
    <string name="channel_break_reminders_description">Gentle nudges from your pet to stand up and stretch</string>
    <string name="reminder_title">Time for a Bun Break</string>
    <!-- %1$s is the pet's name -->
    <string-array name="reminder_texts">
        <item>%1$s is getting stiff… 2-minute stretch?</item>
        <item>%1$s has been sitting with you for a while. Bun Break?</item>
        <item>%1$s\'s ears are drooping. Stand up together?</item>
        <item>%1$s would love a quick wiggle. Coming?</item>
    </string-array>
    <!-- Suggested break, e.g. "Neck stretch · 2 min" -->
    <string name="reminder_suggestion">%1$s · %2$d min</string>
    <string name="action_done">Done</string>
    <string name="action_snooze">Snooze 10 min</string>
    <string name="action_skip">Skip</string>

    <!-- Home -->
    <string name="home_time_since_break">Time since last break</string>
    <plurals name="home_minutes">
        <item quantity="one">%d min</item>
        <item quantity="other">%d min</item>
    </plurals>
    <!-- Mood chip on the timer pill; %1$s is the pet's name -->
    <string name="home_chip_great">%1$s feels great</string>
    <string name="home_chip_tired">%1$s is getting tired</string>
    <string name="home_chip_stiff">%1$s is stiff</string>
    <string name="home_chip_walk">%1$s is out on a walk</string>
    <!-- Outside work hours (no timer, no guilt) -->
    <string name="home_asleep_title">%1$s is asleep</string>
    <!-- %1$s is a time like 9:00 -->
    <string name="home_work_starts_today">Work hours start today at %1$s</string>
    <string name="home_work_starts_tomorrow">Work hours start tomorrow at %1$s</string>
    <!-- %1$s is a weekday like Monday, %2$s a time -->
    <string name="home_work_starts_on">Work hours start %1$s at %2$s</string>
    <string name="home_no_work_hours">No work hours set</string>
    <string name="home_take_break">Take a 2-min break</string>
    <string name="home_breaks_title">Breaks for today</string>
    <string name="home_breaks_done">%1$d of %2$d done</string>
    <string name="home_break_skipped">Skipped today</string>
    <string name="home_reward">+%1$d</string>

    <!-- Focused break card -->
    <string name="break_category_movement">Movement</string>
    <string name="break_category_stretch">Stretch</string>
    <string name="break_category_eyes">Eyes</string>
    <string name="break_category_water">Water</string>
    <!-- e.g. "Reminds you every 45 min · 9 AM–6 PM" (24-hour: "9:00–18:00") -->
    <!-- U+00A0 keeps "·" with "min"; U+2060 (word joiner) keeps the time range together, so a
         narrow screen wraps before the range, never inside it -->
    <string name="focus_reminds">Reminds you every %1$d min · %2$s\u2060–\u2060%3$s</string>
    <string name="focus_skip">Skip</string>
    <string name="focus_done">Done</string>
    <string name="focus_snooze">Snooze 10m</string>

    <!-- Home content descriptions (TalkBack) -->
    <string name="cd_open_menu">Open menu</string>
    <plurals name="cd_sparks">
        <item quantity="one">%d spark</item>
        <item quantity="other">%d sparks</item>
    </plurals>
    <string name="cd_mark_break_done">Mark %1$s as done</string>
    <string name="cd_break_done">%1$s, done</string>
    <!-- TalkBack says "Double tap to open break options" on a break card -->
    <string name="cd_open_break">open break options</string>
    <string name="cd_snooze">Snooze 10 minutes</string>
    <string name="cd_close">Close</string>

    <!-- Break session (BreakSession.dc.html). Plain, gentle wording: no medical claims. -->
    <string name="session_step">Step %1$d of %2$d</string>
    <string name="session_safety">Move gently. Stop if anything hurts.</string>
    <string name="session_pause">Pause</string>
    <string name="session_resume">Resume</string>
    <!-- Under the dimmed countdown while the session is paused -->
    <string name="session_paused">Paused</string>
    <string name="session_next">Next step</string>
    <string name="session_done">Done</string>
    <!-- Countdown, e.g. 0:11 -->
    <string name="session_countdown" translatable="false">%1$d:%2$02d</string>
    <string name="cd_close_break">Close break</string>
    <!-- Read by TalkBack when a new step starts: "Step 2 of 4. Slowly tilt…" -->
    <string name="cd_step_instruction">%1$s. %2$s</string>
    <!-- Countdown for TalkBack, e.g. "1 minute 30 seconds left" -->
    <string name="cd_time_left">%1$s left</string>
    <string name="cd_minutes_seconds">%1$s %2$s</string>
    <plurals name="cd_minutes">
        <item quantity="one">%d minute</item>
        <item quantity="other">%d minutes</item>
    </plurals>
    <plurals name="cd_seconds">
        <item quantity="one">%d second</item>
        <item quantity="other">%d seconds</item>
    </plurals>

    <string name="step_stand_up_1">Sit near the front of your chair with your feet flat on the floor.</string>
    <string name="step_stand_up_2">Lean forward a little and push up through your legs.</string>
    <string name="step_stand_up_3">Stand up tall and let your arms hang loose.</string>
    <string name="step_stand_up_4">Reach both arms up and take a slow breath.</string>
    <string name="step_walk_1">Stand up and walk around, or march on the spot.</string>
    <string name="step_walk_2">Keep going. Swing your arms and breathe easy.</string>
    <string name="step_neck_1">Sit tall and let your shoulders drop.</string>
    <string name="step_neck_2">Slowly tilt your head toward your right shoulder. Breathe out and hold.</string>
    <string name="step_neck_3">Bring your head back to the middle.</string>
    <string name="step_neck_4">Now tilt gently toward your left shoulder and hold.</string>
    <string name="step_shoulders_1">Slowly roll your shoulders up, back and down.</string>
    <string name="step_shoulders_2">Now roll them the other way: down, back and up.</string>
    <string name="step_wrist_1">Hold your right arm out, palm up. Gently ease the fingers back with your other hand.</string>
    <string name="step_wrist_2">Now the left arm, just as gently.</string>
    <string name="step_eyes_1">Look at something far away, about 6 metres (20 feet) from you.</string>
    <string name="step_eyes_2">Blink slowly a few times.</string>
    <string name="step_eyes_3">Close your eyes and let them rest.</string>
    <string name="step_water_1">Fetch a glass of water.</string>
    <string name="step_water_2">Take a few slow sips.</string>

    <!-- Celebration after a break -->
    <string name="celebrate_title">Great job!</string>
    <!-- %1$s is the pet's name -->
    <string name="celebrate_subtitle">%1$s feels so much better.</string>
    <plurals name="celebrate_sparks">
        <item quantity="one">+%d spark</item>
        <item quantity="other">+%d sparks</item>
    </plurals>
    <!-- %1$d is the streak length in work days, %2$d the bonus sparks -->
    <plurals name="celebrate_streak_bonus">
        <item quantity="one">%1$d-day streak bonus +%2$d</item>
        <item quantity="other">%1$d-day streak bonus +%2$d</item>
    </plurals>
    <!-- %1$d breaks done today, %2$d needed for the streak -->
    <plurals name="streak_progress">
        <item quantity="one">%1$d of %2$d break for your streak</item>
        <item quantity="other">%1$d of %2$d breaks for your streak</item>
    </plurals>
    <plurals name="streak_today_counts">
        <item quantity="one">Today counts! %d-day streak</item>
        <item quantity="other">Today counts! %d-day streak</item>
    </plurals>
    <string name="celebrate_continue">Continue</string>

    <!-- Content descriptions -->
    <string name="cd_done">Done</string>
    <string name="cd_mark_done">Mark as done</string>
</resources>
