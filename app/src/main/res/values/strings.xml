    <string name="onboarding_continue">Continue</string>
    <string name="onboarding_skip">Skip</string>
    <string name="onboarding_step">Step %1$d of %2$d</string>
    <string name="wake_title">Shh… someone’s\nstill asleep</string>
    <string name="wake_body">They’ve been sitting way too long.\nHelp them wake up and stretch.</string>
    <string name="wake_cta">Tap to wake them up</string>
    <string name="intro_title">Hi!\nThat was some nap!</string>
    <string name="intro_body">Thanks for waking me up.\nLet’s keep each other moving.</string>
    <string name="intro_cta">Nice to meet you</string>
