<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Android 12+ always shows a system splash on a cold start: the launcher icon on a plain
         background. Pin both, so it's the Wigglebun icon on cream (CLAUDE.md §6.1), not a guess
         from the window background. Older versions show the cream window background only. -->
    <style name="Theme.Wigglebun" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/cream</item>
        <item name="android:windowSplashScreenBackground">@color/cream</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
    </style>
</resources>
