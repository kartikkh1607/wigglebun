<?xml version="1.0" encoding="utf-8"?>
<!-- Splash for Android 8–11 (CLAUDE.md §6.1), laid out like the system splash on Android 12+:
     cream, the pet in the middle at the same 288 dp, the name at the bottom. It is the launch
     theme's window background; MainActivity switches to the plain theme before drawing. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/cream" />
    <item
        android:width="288dp"
        android:height="288dp"
        android:drawable="@drawable/ic_launcher_foreground"
        android:gravity="center" />
    <item
        android:width="200dp"
        android:height="80dp"
        android:bottom="60dp"
        android:drawable="@drawable/splash_wordmark"
        android:gravity="bottom|center_horizontal" />
</layer-list>
